# Example Terraform Variables File
# Copy this file to terraform.tfvars and update with your values

# Project Configuration
project_id   = "your-gcp-project-id"
project_name = "your-project-name"
region       = "us-east4"  # Change to your preferred region

# Network Configuration
subnet_cidr   = "10.0.0.0/24"
pods_cidr     = "10.1.0.0/16"
services_cidr = "10.2.0.0/16"

# GKE Cluster Configuration
maintenance_start_time = "03:00"
enable_shielded_nodes  = true
logging_service        = "logging.googleapis.com/kubernetes"
monitoring_service     = "monitoring.googleapis.com/kubernetes"

# CPU Node Pool Configuration
cpu_machine_type = "n1-standard-4"
cpu_node_count   = 2
cpu_min_nodes    = 1
cpu_max_nodes    = 5
cpu_enable_spot  = false  # Set to true for cost savings (60-70% discount)

# Private Cluster Configuration
enable_private_nodes    = true   # Nodes don't have public IPs (requires Cloud NAT)
enable_private_endpoint = false  # Control plane accessible from internet (true = private only)
master_ipv4_cidr_block  = "172.16.0.0/28"

# Master authorized networks (who can access the control plane)
# To restrict access, replace with your specific IP ranges
master_authorized_networks = [
  {
    cidr_block   = "0.0.0.0/0"
    display_name = "All networks"
  }
]

# Deletion protection (set to false to allow terraform destroy)
deletion_protection = false

# Node Zones
# Single zone (recommended for cost savings):
cpu_node_locations = ["us-east4-c"]

# Multi-zone (for high availability):
# cpu_node_locations = ["us-east4-a", "us-east4-b", "us-east4-c"]
